# Telegram crawler - environment variables
# Copy this file to `.env` and fill in real values. The `.env` file is
# git-ignored and is auto-loaded at startup by python-dotenv.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Telethon credentials - comma-separated, one pair per worker process.
# Get these at https://my.telegram.org/apps
TELEGRAM_API_IDS=api_id_1,api_id_2
TELEGRAM_API_HASHES=api_hash_1,api_hash_2

# MongoDB connection string
MONGODB_URI=mongodb://user:password@host:port/?authMechanism=DEFAULT

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# MONGODB_DB=MyCrawler
# N_PROCESSES=2
# THRESHOLD_LEAVE_HOURS=24.0
# THRESHOLD_REQUEST_HOURS=24.0
